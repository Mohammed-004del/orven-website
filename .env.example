# Build-time public settings. Never put secrets in the browser bundle.
ORVEN_SITE_URL=https://YOUR-ASSIGNED-NAME.YOUR-SUBDOMAIN.workers.dev
ORVEN_FORM_ENDPOINT=/api/inquiry
ORVEN_TURNSTILE_SITE_KEY=YOUR-PUBLIC-SITE-KEY
# Set Worker secrets through `wrangler secret put`, not this file:
# GAS_WEB_APP_URL, GAS_SHARED_SECRET, TURNSTILE_SECRET_KEY
