{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orven",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "ratelimits": [
    {"name":"INQUIRY_RATE_LIMITER","namespace_id":"104901","simple":{"limit":3,"period":60}},
    {"name":"GLOBAL_RATE_LIMITER","namespace_id":"104902","simple":{"limit":20,"period":60}}
  ],
  "observability": {"enabled":false},
  "vars": {"SITE_URL":"https://orven.orven-agency01.workers.dev"}
}
